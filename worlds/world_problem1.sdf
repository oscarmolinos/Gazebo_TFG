<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="world_problem1">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Cubo blanco grande 3x3x3 m, centrado y apoyado en el suelo (centro en z=1.5) -->
    <model name="cubo_blanco">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name="cubo_blanco_link">
        <collision name="cubo_blanco_col">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_blanco_vis">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cubo pequeno ROJO 0.2x0.2x0.2 m, esquina superior (+x, +y) -->
    <!-- Apoyado sobre la cara superior (z = 3 + 0.1) e insertado 0.1 desde el borde -->
    <model name="cubo_rojo">
      <static>true</static>
      <pose>1.4 1.4 3.1 0 0 0</pose>
      <link name="cubo_rojo_link">
        <collision name="cubo_rojo_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_rojo_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.0 0.0 1</ambient>
            <diffuse>0.8 0.0 0.0 1</diffuse>
            <specular>0.5 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cubo pequeno AMARILLO 0.2x0.2x0.2 m, esquina superior opuesta (-x, -y) -->
    <model name="cubo_amarillo">
      <static>true</static>
      <pose>-1.4 -1.4 3.1 0 0 0</pose>
      <link name="cubo_amarillo_link">
        <collision name="cubo_amarillo_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_amarillo_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.0 1</ambient>
            <diffuse>0.9 0.9 0.0 1</diffuse>
            <specular>0.5 0.5 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
