<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="world_problem3">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ============================================================= -->
    <!-- OBSTACULOS                                                    -->
    <!-- ============================================================= -->

    <!-- Obstaculo 1: cubo 3x3x3, cara inferior centrada en (-5, 0) -->
    <!-- Centro del modelo en z = 1.5 (mitad de la altura) -->
    <model name="obstaculo_1">
      <static>true</static>
      <pose>-5 0 1.5 0 0 0</pose>
      <link name="obstaculo_1_link">
        <collision name="obstaculo_1_col">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstaculo_1_vis">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo 2: cubo 3x3x3, cara inferior centrada en (0, -5) -->
    <!-- Centro del modelo en z = 1.5 -->
    <model name="obstaculo_2">
      <static>true</static>
      <pose>0 -5 1.5 0 0 0</pose>
      <link name="obstaculo_2_link">
        <collision name="obstaculo_2_col">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstaculo_2_vis">
          <geometry>
            <box>
              <size>3 3 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo 3: cubo 3x3x6, cara inferior centrada en (2, 5) -->
    <!-- Centro del modelo en z = 3.0 (mitad de la altura = 6/2) -->
    <model name="obstaculo_3">
      <static>true</static>
      <pose>2 5 3 0 0 0</pose>
      <link name="obstaculo_3_link">
        <collision name="obstaculo_3_col">
          <geometry>
            <box>
              <size>3 3 6</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstaculo_3_vis">
          <geometry>
            <box>
              <size>3 3 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- CUBOS DE COLORES (0.2 x 0.2 x 0.2)                            -->
    <!-- Apoyados sobre la cara superior del obstaculo, en una esquina -->
    <!-- (insertados 0.1 m hacia dentro: cara externa enrasada al borde)-->
    <!-- ============================================================= -->

    <!-- Obstaculo 1 (top z=3): 2 cubos -->

    <!-- ROJO: esquina (+x, +y) del obstaculo 1 -->
    <model name="cubo_rojo">
      <static>true</static>
      <pose>-3.6 1.4 3.1 0 0 0</pose>
      <link name="cubo_rojo_link">
        <collision name="cubo_rojo_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_rojo_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.0 0.0 1</ambient>
            <diffuse>0.8 0.0 0.0 1</diffuse>
            <specular>0.5 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- AMARILLO: esquina (-x, -y) del obstaculo 1 -->
    <model name="cubo_amarillo">
      <static>true</static>
      <pose>-6.4 -1.4 3.1 0 0 0</pose>
      <link name="cubo_amarillo_link">
        <collision name="cubo_amarillo_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_amarillo_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.0 1</ambient>
            <diffuse>0.9 0.9 0.0 1</diffuse>
            <specular>0.5 0.5 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo 2 (top z=3): 2 cubos -->

    <!-- AZUL: esquina (+x, +y hacia el centro) del obstaculo 2 -->
    <model name="cubo_azul">
      <static>true</static>
      <pose>1.4 -3.6 3.1 0 0 0</pose>
      <link name="cubo_azul_link">
        <collision name="cubo_azul_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_azul_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.5 1</ambient>
            <diffuse>0.0 0.0 0.8 1</diffuse>
            <specular>0.1 0.1 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- VERDE: esquina (-x, -y) del obstaculo 2 -->
    <model name="cubo_verde">
      <static>true</static>
      <pose>-1.4 -6.4 3.1 0 0 0</pose>
      <link name="cubo_verde_link">
        <collision name="cubo_verde_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_verde_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.5 0.0 1</ambient>
            <diffuse>0.0 0.8 0.0 1</diffuse>
            <specular>0.1 0.5 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo 3 (top z=6): 2 cubos -->

    <!-- NARANJA: esquina (+x, +y hacia el centro) del obstaculo 3 -->
    <model name="cubo_naranja">
      <static>true</static>
      <pose>3.4 6.4 6.1 0 0 0</pose>
      <link name="cubo_naranja_link">
        <collision name="cubo_naranja_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_naranja_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.25 0.0 1</ambient>
            <diffuse>0.9 0.5 0.0 1</diffuse>
            <specular>0.5 0.3 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- MORADO: esquina (-x, -y) del obstaculo 3 -->
    <model name="cubo_morado">
      <static>true</static>
      <pose>0.6 3.6 6.1 0 0 0</pose>
      <link name="cubo_morado_link">
        <collision name="cubo_morado_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_morado_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.0 0.4 1</ambient>
            <diffuse>0.6 0.0 0.8 1</diffuse>
            <specular>0.3 0.1 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cubo suelto: cara inferior centrada en (0, 0) -->
    <!-- Centro del modelo en z = 0.1 (mitad de 0.2), apoyado en el suelo -->

    <!-- CIAN -->
    <model name="cubo_cian">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="cubo_cian_link">
        <collision name="cubo_cian_col">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="cubo_cian_vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.5 0.5 1</ambient>
            <diffuse>0.0 0.8 0.8 1</diffuse>
            <specular>0.1 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
